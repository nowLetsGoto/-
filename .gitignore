node_modules/

# Python 编译缓存（scripts/*.py 运行后生成）。
__pycache__/
*.pyc
dist/
bin/
.env
*.log

# 前端构建产物由 npm run build 生成；仅保留一份兜底 index.html 供 //go:embed 编译通过。
server/public/*
!server/public/index.html

# 运行时数据目录（含 tmp 暂存与 uploads 正式包），不入库。
/storage/

# 日志目录。*.log 只挡住文件本身，目录里若出现非 .log 的产物
# （崩溃转储、临时文件）仍会被 git 看到，这里整体忽略。
# 服务现在把日志写在 ~/dandelion-runtime/logs（桌面受 TCC 保护），
# 但仓库内可能留有旧日志，统一挡掉。
/logs/

# 迁移前的数据库快照：含真实用户数据，只留本地，绝不入库。
.backup/

# 部署产物：构建生成，不入库（用 make build 重新生成）。
dandelion-deploy.tar.gz
deploy/server/dandelion

# 本地排查用的一次性脚本与工作记录，不入库。
scripts/r2probe/
scripts/speedtest-real.sh
scripts/migrate-tunnel-to-r2-account.sh
scripts/sync-r2-all.sh
server/cmd/r2probe/
.workbuddy/memory/
