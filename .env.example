# Dandelion 环境变量样例。复制为 .env 后按需修改；Makefile 会把它导出给子进程。
# 唯一读取处是 server/internal/config/config.go（VITE_API_BASE 由前端 Vite 读取）。

# PostgreSQL 连接串。本地用 sslmode=disable，公网/生产改为 sslmode=require。
DATABASE_URL=postgres://dandelion:dandelion@localhost:5432/dandelion?sslmode=disable

# 对外访问入口基址（协议 + 域名/IP + 端口），不等于后端监听地址。
# 它是二维码内容、复制地址、下载按钮三个绝对 URL 的唯一来源，必须手机可达。
# 场景一 本地开发：http://<开发机局域网IP>:5173  （手机与开发机同 WiFi；不要填 :10088，dev 下 Go 不托管 SPA）
# 场景二 单机内网：http://<内网IP>:10088 或 http://dandelion.internal
# 场景三 公网容器：https://dandelion.example.com
# 禁止 localhost / 127.0.0.1 / 0.0.0.0 / ::1 / 容器内部服务名；生产环境非法会 fail-fast。
PUBLIC_BASE_URL=http://192.168.1.20:5173

# 后端监听端口与地址。
PORT=10088
HOST=0.0.0.0

# 运行时数据根目录，相对进程工作目录；make 系列命令的工作目录为仓库根。
STORAGE_DIR=./storage

# 单包上传上限（MB），与契约 x-constants.maxUploadMB 保持一致，且不得大于该值。
MAX_UPLOAD_MB=300

# 运行环境：development 放宽不可达基址（前端二维码区显示提示），其余值按生产严格校验。
GO_ENV=development

# 管理员账号（唯一账号，不落库）。登录后 token 以 HMAC 签名，有效期 12 小时。
# 生产环境务必改掉默认口令。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123456

# 登录签名及分享子密钥的根密钥。轮换会使已发登录令牌和分享签名失效。
# 生产环境必须改（否则启动 fail-fast），生成方式：openssl rand -hex 32
AUTH_SECRET=dandelion-dev-only-secret-change-me

# 前端 API 基址，留空表示同源（Vite proxy / Nginx 反代）。
VITE_API_BASE=

# ── Cloudflare R2 对象存储（可选）────────────────────────────
# 用途：把安装包镜像到 R2，下载时 302 跳转到 R2 直链，绕开本机带宽。
# 文件权威副本始终在本机 storage/ 目录，R2 只是加速通道；
# 四项必填全空则完全不启用，下载走本地（与改造前一致）。
# 在 Cloudflare 控制台 → R2 → Manage R2 API Tokens 创建。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 可选：绑定到桶的自定义域名（如 https://download.example.com）。
# 不填 → 私有桶签名 URL，走 r2.cloudflarestorage.com S3 端点，国内实测 0.55 MB/s。
# 填了 → 公开桶 CDN 直链，走 Cloudflare 边缘节点，预期 5-20 MB/s。
# 注意：配此项要求桶设为公开读（Cloudflare 规定自定义域名只支持公开桶）；
#       对象名用不可测的 UUID，业务鉴权仍在后端，鉴权通过才返回下载 URL。
# 详见 deploy/server/CDN-SPEEDUP.md。
R2_PUBLIC_BASE_URL=
