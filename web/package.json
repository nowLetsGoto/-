{
  "name": "dandelion-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,scss}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,scss}\"",
    "prepare": "cd .. && husky web/.husky"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@kwayteow/utils": "^0.7.0",
    "@seakoi/console-kit": "^0.5.16",
    "@seakoi/corebox": "^0.0.10",
    "@tinymce/tinymce-react": "^6.3.1",
    "ahooks": "^3.11.0",
    "antd": "^5.29.3",
    "axios": "^1.21.1",
    "bignumber.js": "^11.1.5",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "highlight.js": "^11.12.0",
    "keepalive-for-react": "^2.0.18",
    "ky": "^1.14.3",
    "lodash-es": "^4.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-error-boundary": "^6.1.6",
    "react-router-dom": "^6.26.0",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-config-standard-scss": "^14.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ]
  }
}
